# Copy to `.env` (Vite loads it automatically).
# Must match `common/config.py` / `SIGNALING_URL` and `ICE_SERVERS` on the Python side.

VITE_SIGNALING_URL=wss://kiera-unsensory-kathrine.ngrok-free.dev
VITE_BACKEND_URL=https://localhost:8080


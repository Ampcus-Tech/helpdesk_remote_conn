{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the viewer window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:default"
  ]
}
